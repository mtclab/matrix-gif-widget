# Matrix GIF Widget environment
# Get a free Tenor API key at https://developers.google.com/tenor
VITE_GIF_API_KEY=
# Optional: proxy URL (defaults to same-origin when deployed with server.mjs)
VITE_GIF_PROXY_URL=

# Server-side API keys (required for proxy routes)
TENOR_API_KEY=
GIPHY_API_KEY=

# CORS: comma-separated origins allowed to call the API proxy
# e.g. CORS_ORIGINS=https://element.example.com,https://chat.example.com
CORS_ORIGINS=

# CSP frame-ancestors: which domains can iframe this widget
# e.g. FRAME_ANCESTORS='self' https://element.example.com https://chat.example.com
FRAME_ANCESTORS='self'

PORT=3000